{
  "installCommand": "cd OceanScope/frontend && npm install --loglevel=error",
  "buildCommand": "cd OceanScope/frontend && npm run build",
  "outputDirectory": "OceanScope/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
