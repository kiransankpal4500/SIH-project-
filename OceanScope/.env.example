# ============================================================
# OceanScope Environment Configuration
# Copy this file to .env and adjust values for your environment
# ============================================================

# --- Frontend Configuration ---
VITE_APP_TITLE=OceanScope
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MOCK_DATA=true

# --- Backend Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- INCOIS ERDDAP (Argo Observations) ---
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap/

# --- HYCOM NetCDF Data Directory ---
# Relative or absolute path to the directory containing RSMC_hycom_*.nc files
HYCOM_DATA_DIRECTORY=backend/data/netcdf/hycom

# --- Performance Tuning ---
HTTP_TIMEOUT_SECONDS=10
CACHE_EXPIRATION_SECONDS=600
