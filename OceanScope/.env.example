# ============================================================
# OceanScope Production Environment Template
# ============================================================

# --- Frontend Configuration (Vercel / Client) ---
# Remote FastAPI Backend URL (e.g., https://api.yourdomain.com)
VITE_API_URL=

# --- Backend Server Configuration (FastAPI) ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed origins for CORS (e.g., https://your-oceanscope.vercel.app or "*")
CORS_ALLOWED_ORIGINS=

# --- In-Situ Ocean Telemetry (INCOIS ERDDAP) ---
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap/

# --- Numerical Ocean Model Persistent Storage ---
# Persistent directory where RSMC_hycom_*.nc files are mounted
HYCOM_DATA_DIRECTORY=/data/hycom

# --- Query Caching & Timeouts ---
HTTP_TIMEOUT_SECONDS=10
CACHE_EXPIRATION_SECONDS=600

# --- Copernicus Marine Service Credentials (Optional) ---
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

