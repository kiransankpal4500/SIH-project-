# ============================================================
# OceanScope Backend Environment Configuration
# ============================================================

HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ALLOWED_ORIGINS=*

# In-Situ Ocean Telemetry
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap/

# HYCOM Model Storage
HYCOM_DATA_DIRECTORY=/data/hycom

# Query Caching & Timeouts
HTTP_TIMEOUT_SECONDS=10
CACHE_EXPIRATION_SECONDS=600

# Copernicus Marine Service Credentials (Optional - empty will activate fallback mode)
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
