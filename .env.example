# ============================================================
# OceanScope Production Environment Template
# ============================================================

# --- Frontend Configuration ---
# Set VITE_API_BASE_URL to point to the production backend API (e.g. https://your-backend.vercel.app)
# If empty on production host, requests default safely to relative /api/v1 (never localhost)
VITE_API_BASE_URL=
VITE_API_URL=
VITE_ENABLE_MOCK_DATA=false

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ALLOWED_ORIGINS=*

# --- Data Sources & Telemetry ---
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap/
HTTP_TIMEOUT_SECONDS=10
CACHE_EXPIRATION_SECONDS=600

# --- HYCOM Remote Dataset Configuration ---
HYCOM_DATA_SOURCE=remote
HYCOM_REMOTE_OPENDAP_URL=https://tds.hycom.org/thredds/dodsC/GLBy0.08/expt_93.0
HYCOM_DATASET_ID=GLBy0.08_expt_93.0
HYCOM_CURRENT_OPENDAP_BASE=https://tds.hycom.org/thredds/dodsC/ESPC-D-V02
HYCOM_CURRENT_DATASET_ID=ESPC-D-V02
HYCOM_REMOTE_TIMEOUT_SECONDS=15
HYCOM_DATA_DIRECTORY=backend/data/netcdf/hycom

# --- Copernicus Marine Service Credentials (Optional) ---
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
